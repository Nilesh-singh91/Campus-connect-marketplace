generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum TransactionType {
  SELL
  EXCHANGE
  BOTH
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  REMOVED
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ReportTargetType {
  LISTING
  USER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARN_USER
  SUSPEND_USER
  BAN_USER
  REMOVE_LISTING
  DISMISS_REPORT
}

enum NotificationType {
  MESSAGE
  EXCHANGE_REQUEST
  LISTING_UPDATE
  REPORT_STATUS
  SYSTEM
}

model CollegeDomain {
  id          String   @id @default(uuid())
  domain      String   @unique
  collegeName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users    User[]
  listings Listing[]

  @@map("college_domains")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  role            Role       @default(STUDENT)
  isEmailVerified Boolean    @default(false)
  verificationToken String?
  status          UserStatus @default(ACTIVE)
  collegeDomainId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  collegeDomain     CollegeDomain?       @relation(fields: [collegeDomainId], references: [id], onDelete: SetNull)
  profile           StudentProfile?
  listings          Listing[]
  favorites         Favorite[]
  conversationMembers ConversationMember[]
  messagesSent      Message[]            @relation("SenderMessages")
  exchangeBuyer     ExchangeRequest[]    @relation("BuyerExchangeRequests")
  exchangeSeller    ExchangeRequest[]    @relation("SellerExchangeRequests")
  reportsCreated    Report[]             @relation("ReporterUser")
  reportsReceived   Report[]             @relation("TargetUser")
  moderationActions ModerationAction[]   @relation("ModeratorActions")
  notifications     Notification[]

  @@index([role])
  @@index([status])
  @@index([collegeDomainId])
  @@map("users")
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  fullName         String
  enrollmentNumber String?
  branch           String?
  yearOfStudy      Int?
  avatarUrl        String?
  phone            String?
  bio              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enrollmentNumber])
  @@map("student_profiles")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  listings Listing[]

  @@map("categories")
}

model Listing {
  id              String          @id @default(uuid())
  title           String
  description     String
  price           Decimal         @default(0.00) @db.Decimal(10, 2)
  condition       ItemCondition   @default(GOOD)
  transactionType TransactionType @default(SELL)
  status          ListingStatus   @default(AVAILABLE)
  views           Int             @default(0)
  userId          String
  categoryId      String
  collegeDomainId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collegeDomain CollegeDomain? @relation(fields: [collegeDomainId], references: [id], onDelete: SetNull)
  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  exchangeTarget ExchangeRequest[] @relation("TargetListing")
  exchangeOffered ExchangeRequest[] @relation("OfferedListing")
  reports       Report[]       @relation("ReportedListing")

  @@index([userId])
  @@index([categoryId])
  @@index([collegeDomainId])
  @@index([status])
  @@index([transactionType])
  @@index([price])
  @@index([createdAt])
  @@map("listings")
}

model ListingImage {
  id           String   @id @default(uuid())
  listingId    String
  url          String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("favorites")
}

model Conversation {
  id        String   @id @default(uuid())
  listingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  members  ConversationMember[]
  messages Message[]

  @@index([listingId])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model ExchangeRequest {
  id               String         @id @default(uuid())
  targetListingId  String
  offeredListingId String?
  buyerId          String
  sellerId         String
  cashDifference   Decimal        @default(0.00) @db.Decimal(10, 2)
  status           ExchangeStatus @default(PENDING)
  message          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  targetListing  Listing  @relation("TargetListing", fields: [targetListingId], references: [id], onDelete: Cascade)
  offeredListing Listing? @relation("OfferedListing", fields: [offeredListingId], references: [id], onDelete: SetNull)
  buyer          User     @relation("BuyerExchangeRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User     @relation("SellerExchangeRequests", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([targetListingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("exchange_requests")
}

model Report {
  id              String           @id @default(uuid())
  reporterId      String
  targetType      ReportTargetType
  targetListingId String?
  targetUserId    String?
  reason          String
  details         String?
  status          ReportStatus     @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reporter          User               @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  targetListing     Listing?           @relation("ReportedListing", fields: [targetListingId], references: [id], onDelete: SetNull)
  targetUser        User?              @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  moderationActions ModerationAction[]

  @@index([reporterId])
  @@index([targetListingId])
  @@index([targetUserId])
  @@index([status])
  @@map("reports")
}

model ModerationAction {
  id            String               @id @default(uuid())
  reportId      String?
  moderatorId   String
  actionType    ModerationActionType
  internalNotes String?
  createdAt     DateTime             @default(now())

  report    Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  moderator User    @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([moderatorId])
  @@map("moderation_actions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
